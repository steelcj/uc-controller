---
# ansible-lint settings for uc-controller.
#
# Roles are not linted or tested here unless the work is on them. roles/
# holds roles being developed in uc-controller, linted and tested in that
# work, so it is left out of a run of the whole repository. Every other role
# is installed from requirements.yml into ~/.ansible/roles, outside the
# repository, which ansible-lint does not reach.
exclude_paths:
  - roles/
