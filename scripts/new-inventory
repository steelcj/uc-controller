#!/usr/bin/env python3
"""Make a new client inventory repository from uc-controller's template.

    scripts/new-inventory <path>

Copies inventory-template/ to <path>, runs git init there with the branch
main, and sets core.hooksPath to .githooks, so the template's pre-commit
hook runs before every commit. Refuses a path that exists and is not an
empty directory. Creates no remote and makes no commit: the first commit
comes once the CHANGE-ME values are replaced, as uc-node's guide 0, Set Up
a Client, describes, with UC_CONTROLLER set to this checkout. Prints what
it made and what to do next.
"""
from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TEMPLATE = REPO / "inventory-template"


def fail(message: str) -> int:
    print(f"new-inventory: {message}", file=sys.stderr)
    return 2


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    target = Path(argv[0]).expanduser()
    if target.exists() and (not target.is_dir() or any(target.iterdir())):
        return fail(f"{target} exists and is not an empty directory")
    if shutil.which("git") is None:
        return fail("git is not on PATH")
    shutil.copytree(TEMPLATE, target, dirs_exist_ok=True)
    hook = target / ".githooks" / "pre-commit"
    hook.chmod(0o755)
    for argv_ in (["git", "init", "-q", "-b", "main"], ["git", "config", "core.hooksPath", ".githooks"]):
        result = subprocess.run(argv_, cwd=target, capture_output=True, text=True)
        if result.returncode != 0:
            return fail(f"{' '.join(argv_)} failed: {result.stderr.strip()}")
    made = target.resolve()
    print(f"Made a client inventory in {made}\n"
          f"  a git repository on the branch main, with its pre-commit hook, no remote and no commit.\n"
          f"Next, as uc-node's guide 0, Set Up a Client (en/docs/guides/0-set-up-a-client.md in uc-node), describes:\n"
          f"  replace every CHANGE-ME value under {made / 'onboard'},\n"
          f"  delete {made / 'raw' / 'incus.yml'} if this client has no Incus server,\n"
          f"  then make the first commit with UC_CONTROLLER={REPO} set.\n"
          f"Keep the repository private: it names the client's hosts and addresses.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
