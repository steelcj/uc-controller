---
# yamllint settings for this client inventory, used by .githooks/pre-commit.
# Several files here are written by uc-controller's playbooks and scripts,
# which emit no document start and do not indent sequences, so neither is
# required.
extends: default
rules:
  document-start: disable
  indentation:
    indent-sequences: consistent
  # A warning, which the pre-commit hook shows and does not stop on. Public
  # key lines run past any limit: an ed25519 key with a client's comment is
  # about 130 characters, and an RSA key several hundred.
  line-length:
    max: 120
    level: warning
