diff --git a/tasks/system.yml b/tasks/system.yml
new file mode 100644
index 0000000..c31f1df
--- /dev/null
+++ b/tasks/system.yml
@@ -0,0 +1,42 @@
+---
+# System-wide umask.
+#
+# login.defs drives two things: useradd uses UMASK (or HOME_MODE, if set) for
+# the permissions of a new home directory, and pam_umask reads UMASK for login
+# sessions. The profile.d drop-in covers login shells on distributions whose
+# /etc/profile sets its own umask.
+#
+# Editing login.defs does not change the umask of the running Ansible
+# connection, so this is safe to run mid-play; its effect is on useradd and
+# future logins, which is why the role must run before users are created.
+
+- name: system | Set UMASK in {{ umask_login_defs }}
+  ansible.builtin.lineinfile:
+    path: "{{ umask_login_defs }}"
+    regexp: '^#?\s*UMASK\b'
+    line: "UMASK\t\t{{ umask }}"
+    owner: root
+    group: root
+    mode: "0644"
+    backup: true
+
+- name: system | Set HOME_MODE in {{ umask_login_defs }}
+  ansible.builtin.lineinfile:
+    path: "{{ umask_login_defs }}"
+    regexp: '^#?\s*HOME_MODE\b'
+    line: "HOME_MODE\t{{ umask_home_mode }}"
+    owner: root
+    group: root
+    mode: "0644"
+  when:
+    - umask_home_mode | length > 0
+
+- name: system | Deploy /etc/profile.d/umask.sh
+  ansible.builtin.copy:
+    dest: /etc/profile.d/umask.sh
+    content: "umask {{ umask }}\n"
+    owner: root
+    group: root
+    mode: "0644"
+  when:
+    - umask_profile_d | bool
diff --git a/vars/main.yml b/vars/main.yml
new file mode 100644
index 0000000..155a48a
--- /dev/null
+++ b/vars/main.yml
@@ -0,0 +1,9 @@
+---
+# vars file for umask
+
+# login.defs holds UMASK and HOME_MODE on the Debian and RedHat families.
+# Other families fall back to the same path, which is correct where present.
+_umask_login_defs:
+  default: /etc/login.defs
+
+umask_login_defs: "{{ _umask_login_defs[ansible_facts['os_family']] | default(_umask_login_defs['default']) }}"
